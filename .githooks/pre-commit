#!/usr/bin/env bash
set -euo pipefail

echo "🔍 Pre-commit: running CI checks..."

# 1. Formatting
echo "  ▸ dart format"
dart format --output=none --set-exit-if-changed . || {
  echo "❌ Formatting failed. Run: dart format ."
  exit 1
}

# 2. Static analysis
echo "  ▸ flutter analyze"
flutter analyze --fatal-infos || {
  echo "❌ Analysis failed."
  exit 1
}

# 3. Dart/Flutter VM tests (non-web)
echo "  ▸ flutter test (VM)"
for pkg in packages/chainkey packages/chainkey_platform_interface packages/chainkey_android packages/chainkey_ios; do
  if [ -d "$pkg/test" ]; then
    (cd "$pkg" && flutter test --no-pub) || {
      echo "❌ Tests failed in $pkg"
      exit 1
    }
  fi
done

# 4. Web tests
echo "  ▸ flutter test (web/chrome)"
if [ -d "packages/chainkey_web/test" ]; then
  (cd packages/chainkey_web && flutter test --platform chrome --no-pub) || {
    echo "❌ Web tests failed."
    exit 1
  }
fi

echo "✅ All pre-commit checks passed."
